{
  "name": "Telegram AI Chat Bot",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "webhookId": "telegram-ai-chatbot",
      "credentials": {
        "telegramApi": { "id": "", "name": "Telegram Bot API" }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.message.text }}",
                    "rightValue": "/start",
                    "operator": { "type": "string", "operation": "startsWith" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Start"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "conditions": [
                  {
                    "id": "c2",
                    "leftValue": "={{ ($json.message.text || '').trim() }}",
                    "rightValue": "",
                    "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Text"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Unsupported"
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000002",
      "name": "Route Message",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=Hi {{ $('Telegram Trigger').item.json.message.from.first_name || 'there' }}! I'm an AI assistant. Send me any question and I'll answer. I remember the last few messages of our chat.",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "a1f0c001-0000-4000-8000-000000000003",
      "name": "Send Welcome",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [480, 80],
      "credentials": {
        "telegramApi": { "id": "", "name": "Telegram Bot API" }
      }
    },
    {
      "parameters": {
        "operation": "sendChatAction",
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "action": "typing"
      },
      "id": "a1f0c001-0000-4000-8000-000000000004",
      "name": "Show Typing",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [480, 300],
      "onError": "continueRegularOutput",
      "credentials": {
        "telegramApi": { "id": "", "name": "Telegram Bot API" }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Telegram Trigger').item.json.message.text }}",
        "options": {
          "systemMessage": "You are a helpful, concise assistant chatting with a user on Telegram. Reply in plain text (no Markdown tables or headings). Keep answers short unless the user asks for detail. If you don't know something, say so."
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000005",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [700, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-5-5",
          "cachedResultName": "Claude Sonnet 5.5"
        },
        "options": { "maxTokensToSample": 1024 }
      },
      "id": "a1f0c001-0000-4000-8000-000000000006",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [620, 520],
      "credentials": {
        "anthropicApi": { "id": "", "name": "Anthropic API" }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "contextWindowLength": 10
      },
      "id": "a1f0c001-0000-4000-8000-000000000007",
      "name": "Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [800, 520]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ ($json.output || '').length > 4000 ? $json.output.slice(0, 4000) + '…' : ($json.output || 'Sorry, I got an empty response. Please try again.') }}",
        "additionalFields": {
          "appendAttribution": false,
          "reply_to_message_id": "={{ $('Telegram Trigger').item.json.message.message_id }}"
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000008",
      "name": "Send Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1000, 220],
      "credentials": {
        "telegramApi": { "id": "", "name": "Telegram Bot API" }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "Sorry, something went wrong on my side. Please try again in a moment.",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "a1f0c001-0000-4000-8000-000000000009",
      "name": "Send Error Fallback",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1000, 400],
      "credentials": {
        "telegramApi": { "id": "", "name": "Telegram Bot API" }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "I can only read text messages for now. Please type your question.",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "a1f0c001-0000-4000-8000-000000000010",
      "name": "Send Unsupported",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [480, 520],
      "credentials": {
        "telegramApi": { "id": "", "name": "Telegram Bot API" }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [[{ "node": "Route Message", "type": "main", "index": 0 }]]
    },
    "Route Message": {
      "main": [
        [{ "node": "Send Welcome", "type": "main", "index": 0 }],
        [{ "node": "Show Typing", "type": "main", "index": 0 }],
        [{ "node": "Send Unsupported", "type": "main", "index": 0 }]
      ]
    },
    "Show Typing": {
      "main": [[{ "node": "AI Agent", "type": "main", "index": 0 }]]
    },
    "AI Agent": {
      "main": [
        [{ "node": "Send Reply", "type": "main", "index": 0 }],
        [{ "node": "Send Error Fallback", "type": "main", "index": 0 }]
      ]
    },
    "Anthropic Chat Model": {
      "ai_languageModel": [[{ "node": "AI Agent", "type": "ai_languageModel", "index": 0 }]]
    },
    "Chat Memory": {
      "ai_memory": [[{ "node": "AI Agent", "type": "ai_memory", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "tags": []
}
